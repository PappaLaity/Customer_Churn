DATABASE_URL = "postgresql+psycopg2://user:password@db:5432/churn_db"
IP_ADDRESS = "http://localhost"
# Generate a secure API key with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_SECRET = "GENERATE_YOUR_OWN_KEY_HERE"
MLFLOW_URI = "http://mlflow:5000"
ENV = "dev"
# NOTE: MLflow now uses a file-based backend store (see Dockerfile.mlflow /
# docker-compose.yml). The former MLFLOW_DB_URL / MLFLOW_DB_USER /
# MLFLOW_DB_PASSWORD Postgres settings are no longer used.
DB_USER = "user"
DB_PASSWORD = "password"
GF_SECURITY_ADMIN_USER = "admin"
GF_SECURITY_ADMIN_PASSWORD = "admin"
# Airflow admin credentials (used by airflow-init to create the first user)
AIRFLOW_ADMIN_USER = "admin"
AIRFLOW_ADMIN_PASSWORD = "CHANGE_ME"
# Grafana SMTP alerting (optional)
SMTP_USER = ""
SMTP_PASSWORD = ""
